/** @var \Orangecat\PurchaseOrder\Block\Order\ListOrder $block */
$purchaseOrders = $block->getPurchaseOrders();
?>
<div class="table-wrapper orders-history">
    <?php if ($purchaseOrders && count($purchaseOrders)): ?>
        <table class="data table table-order-items history" id="my-purchase-orders-table">
            <caption class="table-caption"><?= $escaper->escapeHtml(__('Purchase Orders')) ?></caption>
            <thead>
                <tr>
                    <th scope="col" class="col id"><?= $escaper->escapeHtml(__('PO #')) ?></th>
                    <th scope="col" class="col date"><?= $escaper->escapeHtml(__('Date')) ?></th>
                    <th scope="col" class="col shipping"><?= $escaper->escapeHtml(__('Ship To')) ?></th>
                    <th scope="col" class="col total"><?= $escaper->escapeHtml(__('Order Total')) ?></th>
                    <th scope="col" class="col status"><?= $escaper->escapeHtml(__('Status')) ?></th>
                    <th scope="col" class="col actions"><?= $escaper->escapeHtml(__('Action')) ?></th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($purchaseOrders as $po): ?>
                    <tr>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('PO #')) ?>" class="col id">
                            <?= $escaper->escapeHtml($po->getIncrementId()) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Date')) ?>" class="col date">
                            <?= $escaper->escapeHtml($po->getCreatedAt()) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Ship To')) ?>" class="col shipping">
                            <?= $escaper->escapeHtml($po->getGrandTotal() > 0 ? __('Company Office') : '') ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Order Total')) ?>" class="col total">
                            <?php $priceHelper = $block->helper(\Magento\Framework\Pricing\Helper\Data::class); ?>
                            <?= /* @noEscape */ $priceHelper->currency($po->getGrandTotal(), true, false) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Status')) ?>" class="col status">
                            <?= $escaper->escapeHtml($block->getStatusLabel($po->getStatus())) ?>
                        </td>
                        <td data-th="<?= $escaper->escapeHtmlAttr(__('Action')) ?>" class="col actions">
                            <a href="<?= $escaper->escapeUrl($block->getViewUrl($po)) ?>" class="action view">
                                <span><?= $escaper->escapeHtml(__('View Order')) ?></span>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    <?php else: ?>
        <div class="message info empty">
            <span><?= $escaper->escapeHtml(__('You have no purchase orders.')) ?></span>
        </div>
    <?php endif; ?>
</div>
<div class="actions-toolbar">
    <div class="secondary">
        <a class="action back" href="<?= $escaper->escapeUrl($block->getUrl('customer/account')) ?>">
            <span><?= $escaper->escapeHtml(__('Back')) ?></span>
        </a>
    </div>
</div>
